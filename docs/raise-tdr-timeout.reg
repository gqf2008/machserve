Windows Registry Editor Version 5.00

; Raise the graphics-driver TDR timeout so long GPU ops (inference/JIT/graph)
; are not falsely reset by the watchdog (default ~2s). 60 seconds decimal = 0x3c.
; Import as Administrator (right-click -> Merge, or: reg import <file>), then reboot.

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\GraphicsDrivers]
"TdrDelay"=dword:0000003c
"TdrDdiDelay"=dword:0000003c
